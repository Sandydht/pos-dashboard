{
  "name": "pos-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:uat": "ng build --configuration uat",
    "build:beta": "ng build --configuration beta",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "21.1.4",
    "@angular/compiler": "21.1.4",
    "@angular/core": "21.1.4",
    "@angular/forms": "21.1.4",
    "@angular/platform-browser": "21.1.4",
    "@angular/router": "21.1.4",
    "@ngrx/effects": "21.0.1",
    "@ngrx/store": "21.0.1",
    "@ngrx/store-devtools": "21.0.1",
    "crypto-js": "4.2.0",
    "dexie": "4.3.0",
    "msw": "2.12.10",
    "rxjs": "7.8.0",
    "tslib": "2.3.0",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@angular/build": "21.1.4",
    "@angular/cli": "21.1.4",
    "@angular/compiler-cli": "21.1.4",
    "@tailwindcss/postcss": "4.1.12",
    "@types/crypto-js": "4.2.2",
    "ajv": "8.18.0",
    "husky": "9.1.7",
    "jsdom": "27.1.0",
    "lint-staged": "16.2.7",
    "postcss": "8.5.3",
    "prettier": "3.8.1",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vitest": "4.0.8"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
